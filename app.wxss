page {
  min-height: 100%;
  background: #f4f8fb;
  color: #1c2b36;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

view, text {
  box-sizing: border-box;
}

.page {
  padding: 28rpx 24rpx 60rpx;
}

.card {
  background: #ffffff;
  border: 2rpx solid #dce7ee;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1c2b36;
  margin-bottom: 16rpx;
  padding-left: 18rpx;
  border-left: 8rpx solid #0e6b8a;
}

.note {
  display: block;
  font-size: 24rpx;
  color: #647680;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  background: #e6f2f7;
  color: #0e6b8a;
  margin: 0 12rpx 12rpx 0;
}

.warnbox {
  background: #fdf0e8;
  border-left: 6rpx solid #e2763a;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #7a4526;
  line-height: 1.6;
}

button {
  border-radius: 16rpx;
}
