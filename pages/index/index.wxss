.hero {
  background: linear-gradient(135deg, #0e6b8a, #127f9c);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.hero-title {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
}

.hero-sub {
  color: #ffffff;
  font-size: 26rpx;
  margin-top: 10rpx;
  opacity: 0.92;
}

.hero-note {
  color: #ffffff;
  font-size: 22rpx;
  margin-top: 18rpx;
  opacity: 0.8;
}

.link-list {
  display: flex;
  flex-direction: column;
}

.link-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 2rpx solid #eef3f6;
}

.link-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.link-body {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  flex: 1;
}

.link-name {
  font-size: 30rpx;
  font-weight: 600;
}

.link-desc {
  font-size: 24rpx;
  color: #647680;
  margin-top: 4rpx;
}

.link-url {
  font-size: 22rpx;
  color: #0e6b8a;
  margin-top: 6rpx;
}

.link-arrow {
  font-size: 24rpx;
  color: #0e6b8a;
  flex-shrink: 0;
}

.tip-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f0f4f6;
}

.tip-label {
  width: 100rpx;
  font-size: 26rpx;
  color: #0e6b8a;
  font-weight: 600;
  flex-shrink: 0;
}

.tip-value {
  font-size: 26rpx;
  color: #1c2b36;
  flex: 1;
}

.spot-mini {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eef3f6;
}

.spot-name {
  font-size: 28rpx;
  font-weight: 600;
}

.spot-badge {
  align-self: flex-start;
  font-size: 22rpx;
  color: #0e6b8a;
  background: #e6f2f7;
  border-radius: 20rpx;
  padding: 2rpx 14rpx;
  margin-top: 8rpx;
}

.spot-fish {
  font-size: 24rpx;
  color: #647680;
  margin-top: 8rpx;
  line-height: 1.5;
}

.link-card {
  border-left: 8rpx solid #0e6b8a;
}

.quick-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.quick-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 16rpx 20rpx 16rpx 0;
  box-sizing: border-box;
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 14rpx;
}

.quick-desc {
  font-size: 22rpx;
  color: #647680;
  margin-top: 6rpx;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #94a4ae;
  margin-top: 12rpx;
}
