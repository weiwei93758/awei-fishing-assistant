<import src="/templates/region-bar.wxml" />
<view class="page">
  <view class="hero">
    <text class="hero-title">阿威专属海钓</text>
    <text class="hero-sub">{{region.heroSub}}</text>
    <text class="hero-note">本人专用 · 本地数据 · 无需登录</text>
  </view>

  <template is="regionBar" data="{{regionNames, regionIndex, regionName}}" />

  <view class="card" wx:if="{{bundle.dataNote}}">
    <text class="note" style="margin-bottom:0">{{bundle.dataNote}}</text>
  </view>

  <view class="card">
    <text class="section-title">航海工具</text>
    <text class="note">微信内打开外部网页有限制，点卡片复制官方网址，再粘贴到浏览器打开。</text>
    <view class="link-list">
      <view class="link-item" wx:for="{{links}}" wx:key="id" data-id="{{item.id}}" bindtap="copyLink">
        <view class="link-icon" style="background:{{item.color}}">{{item.icon}}</view>
        <view class="link-body">
          <text class="link-name">{{item.name}}</text>
          <text class="link-desc">{{item.desc}}</text>
          <text class="link-url">{{item.label}}</text>
        </view>
        <text class="link-arrow">复制 ›</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="section-title">今日提示</text>
    <view class="tip-row" wx:for="{{bundle.tips}}" wx:key="label">
      <text class="tip-label">{{item.label}}</text>
      <text class="tip-value">{{item.value}}</text>
    </view>
    <view class="warnbox" style="margin-top:16rpx">{{bundle.tipWarn}}</view>
  </view>

  <view class="card link-card" bindtap="goRecord" style="background:#e8f4f8;border-left:8rpx solid #0e6b8a">
    <text class="section-title">＋ 记一笔（出钓记录）</text>
    <text class="note" style="margin-bottom:0">下拉选潮汐、天气、钓点，拍张照存本机 → 点此开始</text>
  </view>

  <view class="card">
    <text class="section-title">快捷查询</text>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goAnniversary">
        <text class="quick-icon" style="background:#0e6b8a">📅</text>
        <text class="quick-name">往年今日渔获</text>
        <text class="quick-desc">选日期看同日历史渔获</text>
      </view>
      <view class="quick-item" bindtap="goWords">
        <text class="quick-icon" style="background:#8a5b18">📖</text>
        <text class="quick-name">海钓乐趣词语</text>
        <text class="quick-desc">钓友黑话与术语速查</text>
      </view>
      <view class="quick-item" bindtap="goRegionSettings">
        <text class="quick-icon" style="background:#2e7d6b">📍</text>
        <text class="quick-name">自定义定位</text>
        <text class="quick-desc">经纬度、范围与潮汐点</text>
      </view>
      <view class="quick-item" bindtap="goZones">
        <text class="quick-icon" style="background:#4a6fa5">🌊</text>
        <text class="quick-name">海域类型</text>
        <text class="quick-desc">外海 / 内湾 / 养殖圈</text>
      </view>
    </view>
  </view>

  <view class="card link-card" bindtap="goLog">
    <text class="section-title">我的钓记 · 知识库</text>
    <text class="note" style="margin-bottom:0">{{bundle.logCardText}}</text>
  </view>

  <view class="card link-card" bindtap="goTools">
    <text class="section-title">工具箱</text>
    <text class="note" style="margin-bottom:0">潮汐速查、装备清单、安全须知、资料来源 → 点此查看</text>
  </view>

  <view class="card">
    <text class="section-title">钓点速览</text>
    <view class="spot-mini" wx:for="{{spots}}" wx:key="id" data-id="{{item.id}}" bindtap="goSpots">
      <text class="spot-name">{{item.name}}</text>
      <text class="spot-badge">{{item.badge}}</text>
      <text class="spot-fish">{{item.fish}}</text>
    </view>
    <text class="note" style="margin-top:12rpx;margin-bottom:0">点任意钓点进入“钓点”页查看完整档案。</text>
  </view>

  <view class="footer">数据更新：2026-11-22 · 钓友经验与公开资料整理</view>
</view>
