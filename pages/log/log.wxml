<import src="/templates/region-bar.wxml" />
<view class="page">
  <view class="hero">
    <text class="hero-title">{{bundle.logTitle}}</text>
    <text class="hero-sub">{{bundle.logSub}}</text>
    <text class="hero-note">事实与推断分开标注 · 为以后出钓提供依据</text>
  </view>

  <template is="regionBar" data="{{regionNames, regionIndex, regionName}}" />

  <view class="card" wx:if="{{bundle.dataNote}}">
    <text class="note" style="margin-bottom:0">{{bundle.dataNote}}</text>
  </view>

  <view class="card" wx:if="{{logs.length > 0}}">
    <text class="section-title">出钓记录 · 时间线</text>
    <text class="note">{{bundle.logNote}}</text>

    <view class="log-item" wx:for="{{logs}}" wx:key="id">
      <view class="log-head">
        <text class="log-date">{{item.date}}</text>
        <text class="result result-{{item.resultKind}}">{{item.result}}</text>
      </view>
      <view class="meta-row">
        <text class="meta">农历 {{item.lunar}}</text>
        <text class="tide tide-{{item.tideKind}}">{{item.tide}}</text>
      </view>
      <view class="info"><text class="ik">时间</text><text class="iv">{{item.time}}</text></view>
      <view class="info"><text class="ik">天气</text><text class="iv">{{item.weather}}</text></view>
      <view class="info"><text class="ik">水况</text><text class="iv">{{item.water}}</text></view>
      <view class="info"><text class="ik">钓法</text><text class="iv">{{item.gear}}</text></view>
      <view class="info"><text class="ik">渔获</text><text class="iv">{{item.catchText}}</text></view>
      <text class="log-note">{{item.note}}</text>
      <view class="tag-row">
        <text class="log-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="tag">{{tag}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{logs.length === 0}}">
    <text class="section-title">暂无该地区钓记</text>
    <text class="note" style="margin-bottom:0">{{bundle.logNote}}</text>
  </view>

  <view class="card">
    <text class="section-title">规律总结</text>
    <text class="note">以下基于现有样本归纳，含钓法有效性，样本量小，属经验假设，不是定论。</text>
    <view class="insight" wx:for="{{insights}}" wx:key="title">
      <text class="insight-title">{{item.title}}</text>
      <text class="insight-body">{{item.body}}</text>
    </view>
  </view>

  <view class="card">
    <text class="section-title">数据边界</text>
    <view class="boundary" wx:for="{{boundaries}}" wx:key="idx">
      <text class="b-num">{{index + 1}}</text>
      <text class="b-text">{{item}}</text>
    </view>
  </view>
</view>
