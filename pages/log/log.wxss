.hero {
  background: linear-gradient(135deg, #0e6b8a, #127f9c);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.hero-title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  color: #ffffff;
  font-size: 26rpx;
  margin-top: 10rpx;
  opacity: 0.92;
}

.hero-note {
  color: #ffffff;
  font-size: 22rpx;
  margin-top: 16rpx;
  opacity: 0.8;
}

.log-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #eef3f6;
}

.log-item:last-child {
  border-bottom: none;
}

.log-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}

.log-date {
  font-size: 30rpx;
  font-weight: 700;
}

.result {
  font-size: 24rpx;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  margin-left: 12rpx;
}

.result-great { background: #fde8dd; color: #c9522f; }
.result-good  { background: #e4f4ec; color: #20714f; }
.result-normal{ background: #fff2dc; color: #8a5b18; }
.result-bad   { background: #eef1f3; color: #6b7a84; }

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.meta {
  font-size: 24rpx;
  color: #51636f;
}

.tide {
  font-size: 22rpx;
  border-radius: 18rpx;
  padding: 2rpx 14rpx;
  margin-left: 16rpx;
}

.tide-good { background: #e6f2f7; color: #0e6b8a; }
.tide-weak { background: #f2f4f6; color: #6b7a84; }

.info {
  display: flex;
  padding: 8rpx 0;
}

.ik {
  width: 90rpx;
  font-size: 24rpx;
  color: #0e6b8a;
  font-weight: 600;
  flex-shrink: 0;
}

.iv {
  flex: 1;
  font-size: 24rpx;
  color: #1c2b36;
  line-height: 1.6;
}

.log-note {
  display: block;
  font-size: 24rpx;
  color: #51636f;
  background: #f4f8fb;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-top: 10rpx;
  line-height: 1.6;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.log-tag {
  font-size: 22rpx;
  color: #0e6b8a;
  background: #e6f2f7;
  border-radius: 18rpx;
  padding: 2rpx 14rpx;
  margin: 0 12rpx 8rpx 0;
}

.insight {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f4f6;
}

.insight:last-child {
  border-bottom: none;
}

.insight-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0e6b8a;
}

.insight-body {
  display: block;
  font-size: 25rpx;
  color: #1c2b36;
  line-height: 1.7;
  margin-top: 8rpx;
}

.boundary {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0f4f6;
}

.b-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eef1f3;
  color: #6b7a84;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.b-text {
  flex: 1;
  font-size: 24rpx;
  color: #51636f;
  line-height: 1.6;
  margin-left: 14rpx;
}
