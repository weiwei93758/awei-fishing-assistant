.page { padding: 24rpx; background: #f4f8fb; min-height: 100vh; }
.hero { background: linear-gradient(135deg, #0e6b8a, #127f9c); border-radius: 24rpx; padding: 36rpx 32rpx; margin-bottom: 24rpx; display: flex; flex-direction: column; }
.hero-title { font-size: 44rpx; font-weight: 700; color: #fff; display: block; }
.hero-sub { font-size: 26rpx; color: #fff; opacity: 0.92; display: block; margin-top: 10rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(14,107,138,.06); }
.section-title { font-size: 30rpx; font-weight: 700; color: #123; display: block; margin-bottom: 18rpx; }
.input-row { display: flex; align-items: center; background: #f4f8fb; border-radius: 12rpx; padding: 8rpx 20rpx; }
.date-input { flex: 1; height: 80rpx; font-size: 30rpx; color: #123; }
.clear-btn { font-size: 26rpx; color: #7a8a94; padding: 10rpx 16rpx; }
.hint { font-size: 22rpx; color: #90a0aa; display: block; margin-top: 14rpx; line-height: 1.6; }
.quick-wrap { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.quick-chip { font-size: 24rpx; color: #0e6b8a; background: #e8f4f8; border-radius: 40rpx; padding: 10rpx 24rpx; margin: 0 16rpx 16rpx 0; }
.today-chip { background: #0e6b8a; color: #fff; }
.query-btn { margin-top: 12rpx; background: #0e6b8a; color: #fff; font-size: 30rpx; text-align: center; padding: 22rpx; border-radius: 14rpx; font-weight: 600; }
.err-card { display: flex; align-items: flex-start; border-left: 8rpx solid #c9522f; }
.err-icon { width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 50%; background: #c9522f; color: #fff; font-size: 28rpx; font-weight: 700; margin-right: 18rpx; flex-shrink: 0; }
.err-body { flex: 1; }
.err-title { font-size: 28rpx; font-weight: 700; color: #c9522f; display: block; }
.err-text { font-size: 26rpx; color: #555; display: block; margin-top: 8rpx; line-height: 1.6; }
.stat-grid { display: flex; flex-wrap: wrap; }
.stat-item { width: 50%; padding: 18rpx 0; box-sizing: border-box; }
.stat-num { font-size: 44rpx; font-weight: 700; color: #0e6b8a; display: block; }
.stat-label { font-size: 22rpx; color: #7a8a94; display: block; margin-top: 4rpx; }
.warnbox { background: #fff8ee; color: #8a5b18; font-size: 24rpx; line-height: 1.6; padding: 18rpx; border-radius: 12rpx; margin-top: 16rpx; }
.year-item { padding: 20rpx 0; border-bottom: 1rpx solid #eef3f6; }
.year-item:last-child { border-bottom: none; }
.year-head { display: flex; justify-content: space-between; align-items: center; }
.year-name { font-size: 30rpx; font-weight: 600; color: #123; }
.year-val { font-size: 28rpx; color: #0e6b8a; font-weight: 600; }
.bar-track { height: 18rpx; background: #eef3f6; border-radius: 10rpx; margin: 14rpx 0; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg,#0e6b8a,#48a9c4); border-radius: 10rpx; }
.year-detail { font-size: 24rpx; color: #6b7a84; line-height: 1.6; display: block; }
.compare-card { background: #f0f8fb; }
.compare-row { display: flex; }
.compare-box { width: 50%; background: #fff; border-radius: 14rpx; padding: 22rpx; box-sizing: border-box; margin-right: 12rpx; }
.compare-box:last-child { margin-right: 0; }
.compare-k { font-size: 24rpx; color: #7a8a94; display: block; }
.compare-v { font-size: 34rpx; font-weight: 700; color: #0e6b8a; display: block; margin-top: 8rpx; }
.compare-note { font-size: 26rpx; color: #123; display: block; margin-top: 20rpx; line-height: 1.7; }
.log-item { padding: 18rpx 0; border-bottom: 1rpx solid #eef3f6; }
.log-item:last-child { border-bottom: none; }
.log-head { display: flex; justify-content: space-between; }
.log-date { font-size: 26rpx; color: #0e6b8a; font-weight: 600; }
.log-source { font-size: 22rpx; color: #90a0aa; }
.log-main { font-size: 28rpx; color: #123; display: block; margin-top: 8rpx; }
.log-sub { font-size: 24rpx; color: #6b7a84; display: block; margin-top: 6rpx; }
.log-note { font-size: 23rpx; color: #90a0aa; display: block; margin-top: 6rpx; line-height: 1.6; }
.empty-card { text-align: center; padding: 60rpx 28rpx; }
.empty-emoji { font-size: 72rpx; color: #cbd8e0; display: block; }
.empty-title { font-size: 30rpx; font-weight: 600; color: #123; display: block; margin-top: 16rpx; }
.empty-text { font-size: 24rpx; color: #7a8a94; display: block; margin-top: 12rpx; line-height: 1.7; }
.empty-btn { display: inline-block; background: #0e6b8a; color: #fff; font-size: 28rpx; padding: 16rpx 48rpx; border-radius: 40rpx; margin-top: 28rpx; }
.footer { text-align: center; font-size: 22rpx; color: #a0adb5; padding: 20rpx 0 40rpx; }
