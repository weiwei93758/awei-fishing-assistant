.fish-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #eef3f6;
}

.fish-item:last-child {
  border-bottom: none;
}

.fish-head {
  display: flex;
  align-items: center;
}

.fish-name {
  font-size: 30rpx;
  font-weight: 700;
}

.fish-level {
  font-size: 22rpx;
  color: #20714f;
  background: #e4f4ec;
  border-radius: 18rpx;
  padding: 2rpx 14rpx;
  margin-left: 14rpx;
}

.fish-period {
  display: block;
  font-size: 24rpx;
  color: #0e6b8a;
  margin-top: 8rpx;
}

.month-row {
  display: flex;
  margin-top: 14rpx;
}

.month {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  padding: 8rpx 0;
  margin-right: 3rpx;
  border-radius: 6rpx;
  color: #94a4ae;
  background: #eef3f6;
}

.month:last-child {
  margin-right: 0;
}

.m-hot {
  background: #e2763a;
  color: #ffffff;
}

.m-mid {
  background: #f6c9a9;
  color: #7a4526;
}

.fish-line {
  display: block;
  font-size: 24rpx;
  color: #51636f;
  margin-top: 10rpx;
  line-height: 1.5;
}

.real-img {
  width: 100%;
  border-radius: 14rpx;
  margin: 12rpx 0 20rpx;
}

.kv {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f2f5f7;
}

.k2 {
  width: 240rpx;
  font-size: 24rpx;
  color: #0e6b8a;
  font-weight: 600;
  flex-shrink: 0;
}

.v2 {
  flex: 1;
  font-size: 24rpx;
  color: #1c2b36;
  line-height: 1.6;
}
